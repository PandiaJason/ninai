[Unit]
Description=NINAI shared API (nsjail sandbox)
Documentation=https://github.com/PandiaJason/ninai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# nsjail runs as an unprivileged user and builds a new user namespace, so the
# process inside the sandbox has no privileges over the host. It maps itself
# to the "ninai" user (uid 993) inside.
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/ninai
EnvironmentFile=/etc/ninai/api.env

ExecStart=/usr/local/bin/nsjail \
    --mode once \
    --user ninai --group ninai \
    --hostname ninai-api \
    --cwd /opt/ninai \
    --keep_env \
    --disable_clone_newnet \
    --disable_clone_newcgroup \
    --bindmount_ro /usr \
    --bindmount_ro /lib64:/lib64 \
    --bindmount_ro /lib:/lib \
    --bindmount_ro /etc \
    --bindmount_ro /dev \
    --bindmount_ro /run/systemd/resolve:/run/systemd/resolve \
    --bindmount_ro /opt/ninai \
    --bindmount /opt/ninai/logs \
    --tmpfsmount /etc/ninai \
    --tmpfsmount /home/ec2-user \
    --tmpfsmount /root \
    --tmpfsmount /tmp \
    --rlimit_as 1048576000 \
    --rlimit_cpu 240 \
    --rlimit_fsize 10485760 \
    --rlimit_nofile 4096 \
    --rlimit_nproc 256 \
    /usr/bin/node /opt/ninai/server/index.js

Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
LimitNOFILE=4096

# Hardening outside the sandbox
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
ReadWritePaths=/opt/ninai/logs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ninai-api

[Install]
WantedBy=multi-user.target
